{
    "name": "rgss-napi",
    "private": true,
    "version": "0.0.0",
    "description": "Rust napi 构建辅助；请用仓库根 node scripts/build/napi.mjs 写入 projects/platforms/native/rgss-<short>",
    "license": "Apache-2.0",
    "scripts": {
        "build": "node ../../../scripts/build/napi.mjs --release"
    },
    "napi": {
        "name": "rgss",
        "package": {
            "name": "@game-gpt/rgss"
        },
        "triples": {
            "defaults": true,
            "additional": [
                "aarch64-pc-windows-msvc",
                "aarch64-unknown-linux-gnu"
            ]
        }
    },
    "devDependencies": {
        "@napi-rs/cli": "^2.18.0"
    }
}

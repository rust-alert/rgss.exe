{
    "name": "@game-gpt/rgss",
    "version": "0.0.0",
    "description": "RPG Maker 游戏根。命令：rgss --path <游戏根>",
    "type": "commonjs",
    "bin": {
        "rgss": "./dist/cli.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "optionalDependencies": {
        "@game-gpt/rgss-win32-x64": "workspace:*",
        "@game-gpt/rgss-win32-arm64": "workspace:*",
        "@game-gpt/rgss-darwin-x64": "workspace:*",
        "@game-gpt/rgss-darwin-arm64": "workspace:*",
        "@game-gpt/rgss-linux-x64": "workspace:*",
        "@game-gpt/rgss-linux-arm64": "workspace:*",
        "@game-gpt/rgss-unknown-wasm32": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "typescript": "^5.7.0"
    },
    "engines": {
        "node": ">=18"
    },
    "license": "Apache-2.0",
    "keywords": [
        "rgss",
        "rpg-maker",
        "napi",
        "rust"
    ]
}
